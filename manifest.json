{
  "manifest_version": 3,
  "name": "Simple Gmail",
  "version": "1.0.0",
  "description": "A calmer, minimal Gmail: centered inbox, hidden clutter, date groups, floating compose and dark mode.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["springs.css", "content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simple Gmail",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-simplify": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Turn Simple Gmail on / off"
    }
  }
}
